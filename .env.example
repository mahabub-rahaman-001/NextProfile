# ---------- database ----------
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/nextprofile?schema=public"
DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/nextprofile?schema=public"

# ---------- auth ----------
# openssl rand -base64 32
AUTH_SECRET=""

# ---------- AI ----------
LLM_API_KEY=""
LLM_MODEL_FAST=""
LLM_MODEL_STRONG=""
AI_ENABLED="false"          # kill switch: false = builder works, AI actions disabled

# ---------- PDF render service ----------
# Leave RENDER_SERVICE_URL empty to use the built-in local renderer (dev only).
# A bundled Chromium does not fit in a serverless function, so this is required
# on Vercel and anywhere else without a long-lived container.
RENDER_SERVICE_URL=""
RENDER_SERVICE_SECRET=""
# Required everywhere. Empty means every PDF and business-card download fails.
# openssl rand -base64 32
PRINT_TOKEN_SECRET=""

# ---------- storage ----------
# "local" writes into public/uploads and is DEV ONLY: on Vercel the filesystem
# is discarded between invocations, and in Docker the next deploy throws the
# container layer away. Production uses "s3".
STORAGE_DRIVER="local"
NEXT_PUBLIC_CDN_URL=""

# Required when STORAGE_DRIVER="s3". Works with AWS S3, Cloudflare R2,
# Backblaze B2 and MinIO.
S3_BUCKET=""
S3_REGION="auto"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# R2, Backblaze and MinIO need an endpoint; plain AWS S3 does not.
S3_ENDPOINT=""

# ---------- analytics ----------
# Salts the daily-rotating visitor hash. Without it the fallback salt is a
# literal in the source, and the hashes stop being anonymous in any real sense.
# openssl rand -base64 32
ANALYTICS_SALT=""

# ---------- app ----------
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Development only: show the password reset link on screen instead of emailing
# it. NEVER set this in a real deployment — it hands out password resets.
# The app refuses to start with this enabled in production.
AUTH_DEV_SHOW_RESET_LINK="false"

# ==================== PRODUCTION SERVICES ====================

# ---------- proxy / rate limiting ----------
# How many proxies sit in front of the app. The rate limiter reads the client
# address this many entries in from the RIGHT of X-Forwarded-For, so a caller
# cannot choose their own rate-limit key by sending the header themselves.
#   1 = Vercel, or a single nginx / load balancer
#   2 = Cloudflare in front of your own proxy
#   0 = nothing in front; the header is ignored entirely
TRUSTED_PROXY_HOPS="1"

# Redis connection URL for multi-instance rate limiting. Required in production:
# without it the limiter falls back to per-process memory, which does nothing on
# serverless — every invocation starts with an empty map.
# REDIS_URL="rediss://default:password@us1-example-1234.upstash.io:37803"

# ---------- SMTP for password reset emails ----------
# Works with any SMTP provider. For Gmail / Google Workspace, SMTP_PASS must be
# an App Password (Google Account -> Security -> 2-Step Verification -> App
# passwords), not the account password.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="NextProfile <noreply@nextprofile.app>"

# ---------- Google sign-in ----------
# The /api/auth/google route stays closed (503) while this is empty, because
# without it the ID token's audience cannot be verified — and an unverified
# audience means a token issued to ANY Google app would be accepted.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""

# Comma-separated list of allowed image hostnames for next/image
ALLOWED_IMAGE_DOMAINS=""
